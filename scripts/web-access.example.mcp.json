{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.75",
        "--headless",
        "--isolated",
        "--blocked-origins",
        "http://127.0.0.1:*;http://localhost:*;http://[::1]:*;https://127.0.0.1:*;https://localhost:*;https://[::1]:*;http://172.*;http://10.*;http://192.168.*;https://172.*;https://10.*;https://192.168.*;http://169.254.*;https://169.254.*;http://0.0.0.0:*;https://0.0.0.0:*"
      ]
    }
  }
}
